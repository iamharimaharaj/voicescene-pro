{
  "name": "voiceover-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:portfolio": "vite build --mode portfolio --base /voiceover/ --outDir ../../dist/voiceover --emptyOutDir",
    "start": "NODE_ENV=production tsx server.ts",
